# Node Environment (development, test, production)
NODE_ENV=development
PORT=8080

# Databases
DATABASE_URL="postgresql://laundry_user:laundry_pass@localhost:5433/laundry_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Token Settings
ACCESS_TOKEN_SECRET="super-strong-jwt-secret-key-change-in-prod"
ACCESS_TOKEN_TTL_MINUTES=15
PROVISIONAL_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SESSION_CACHE_TTL_SECONDS=900
REFRESH_CONCURRENCY_WINDOW_SECONDS=10

# OTP Settings
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SEND_LIMIT=5
OTP_SEND_WINDOW_MINUTES=60
SMS_PROVIDER=mock

# Legacy Auth Adapter
ENABLE_LEGACY_AUTH_BRIDGE=true

